# Copy to .env and fill in real values. Never commit .env.
SESSION_SECRET="replace-with-a-long-random-string"

PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=your-public-storefront-api-token
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=your-customer-account-api-client-id
SHOP_ID=your-shop-id
PUBLIC_CHECKOUT_DOMAIN=your-checkout-domain

## Optional
PUBLIC_STOREFRONT_ID=your-storefront-id
# PRIVATE_STOREFRONT_API_TOKEN="your-private-storefront-api-token"

# Admin API (ops dashboard, scripts)
# SHOPIFY_ADMIN_API_TOKEN="your-admin-api-token"

# Additional services
# GA4 measurement ID (despite the name, there is no GTM container)
# PUBLIC_GOOGLE_GTM_ID=G-XXXXXXXXXX
# JUDGEME_PRIVATE_API_TOKEN="your-judgeme-private-api-token"

# Custom metafields & metaobjects
METAOBJECT_COLORS_TYPE="shopify--color-pattern"
CUSTOM_COLLECTION_BANNER_METAFIELD="custom.collection_banner"

# Shopify Inbox
## https://github.com/juanpprieto/hydrogen-chat-inbox?tab=readme-ov-file#1-find-your-shopify-inbox-shop-id
PUBLIC_SHOPIFY_INBOX_SHOP_ID=your-shopify-inbox-shop-id
