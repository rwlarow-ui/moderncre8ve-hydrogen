{
  "mcpServers": {
    "ahrefs": {
      "type": "stdio",
      "command": "npx",
      "args": ["--prefix=~/.global-node-modules", "@ahrefs/mcp"],
      "env": {
        "API_KEY": "${AHREFS_API_KEY}"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "shopify": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/rwlarow/.global-node-modules/node_modules/@wolfielabs/shopify-storefront-mcp-server/dist/index.js"
      ],
      "env": {
        "SHOPIFY_STOREFRONT_ACCESS_TOKEN": "${PUBLIC_STOREFRONT_API_TOKEN}",
        "SHOPIFY_STORE_DOMAIN": "${PUBLIC_STORE_DOMAIN}"
      }
    },
    "weaverse": {
      "type": "http",
      "url": "https://docs.weaverse.io/mcp"
    },
    "shopify-dev": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"],
      "env": {
        "OPT_OUT_INSTRUMENTATION": "true"
      }
    },
    "ops-dashboard": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/dev/Desktop/my-hydrogen-storefront/scripts/ops-dashboard-mcp.mjs"],
      "env": {
        "PUBLIC_STORE_DOMAIN": "${PUBLIC_STORE_DOMAIN}",
        "SHOPIFY_ADMIN_API_TOKEN": "${SHOPIFY_ADMIN_API_TOKEN}"
      }
    }
  }
}
